generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so these are plain strings.
// GameStatus: UPCOMING | CANCELLED | COMPLETED (LIVE/FULL are derived at read time, see src/lib/game.ts)
// BookingStatus: CONFIRMED | WAITLISTED | CANCELLED | COMPLETED
// WalletTxnType: TOPUP | BOOKING_PAYMENT | REFUND

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  city          String    @default("Mumbai")
  walletBalance Int       @default(0) // paise-free rupees, integer
  isHost        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  hostedGames    Game[]            @relation("HostedGames")
  bookings       Booking[]
  walletTxns     WalletTransaction[]
  feedback       Feedback[]

  @@map("users")
}

model Venue {
  id      String @id @default(cuid())
  name    String
  city    String
  address String @default("")

  games Game[]

  @@map("venues")
}

model Game {
  id         String     @id @default(cuid())
  title      String
  format     String // e.g. "6v6"
  date       DateTime
  durationMin Int       @default(60)
  pricePerSpot Int
  capacity   Int
  status     String     @default("UPCOMING")
  cancellationPolicy String @default("Cancel up to 4 hours before kickoff for a full refund. Later cancellations forfeit the spot fee.")

  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String

  host   User   @relation("HostedGames", fields: [hostId], references: [id])
  hostId String

  bookings Booking[]

  createdAt DateTime @default(now())

  @@map("games")
}

model Booking {
  id        String        @id @default(cuid())
  status    String        @default("CONFIRMED")
  guestCount Int          @default(0)
  totalPaid Int           @default(0)
  note      String        @default("")
  createdAt DateTime      @default(now())
  cancelledAt DateTime?

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("bookings")
}

model WalletTransaction {
  id        String        @id @default(cuid())
  type      String
  amount    Int // positive = credit, negative = debit
  note      String        @default("")
  createdAt DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("wallet_transactions")
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("feedback")
}
