generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so these are plain strings.
// GameStatus: UPCOMING | CANCELLED | COMPLETED (LIVE/FULL are derived at read time, see src/lib/game.ts)
// BookingStatus: CONFIRMED | WAITLISTED | CANCELLED | COMPLETED

// Only hosts have accounts — players never log in, they just type their name when booking.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isHost       Boolean  @default(false)
  createdAt    DateTime @default(now())

  hostedGames Game[] @relation("HostedGames")

  @@map("users")
}

model Venue {
  id      String @id @default(cuid())
  name    String
  city    String
  address String @default("")

  games Game[]

  @@map("venues")
}

model Game {
  id                 String   @id @default(cuid())
  title              String
  format             String // e.g. "6v6"
  date               DateTime
  durationMin        Int      @default(60)
  pricePerSpot       Int? // left blank until the host sets it (often only known after the game)
  capacity           Int
  status             String   @default("UPCOMING")
  cancellationPolicy String   @default("Cancel up to 24 hours before kickoff to be let off the hook for the spot fee. Later cancellations still owe the fee.")

  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String

  host   User   @relation("HostedGames", fields: [hostId], references: [id])
  hostId String

  bookings Booking[]

  createdAt DateTime @default(now())

  @@map("games")
}

model Booking {
  id          String    @id @default(cuid())
  playerName  String
  status      String    @default("CONFIRMED")
  guestCount  Int       @default(0)
  amountDue   Int       @default(0)
  paid        Boolean   @default(false)
  forfeited   Boolean   @default(false) // cancelled too late — fee is still owed
  note        String    @default("")
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  @@map("bookings")
}

model Feedback {
  id        String   @id @default(cuid())
  name      String   @default("")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@map("feedback")
}
